{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Trace specimen content",
  "type": "object",
  "required": ["system", "hero", "cases", "flows", "evidence"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["name", "version", "status"],
      "properties": {
        "name": { "const": "Decision Trace" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": ["eyebrow", "titleLines", "thesis", "note"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "titleLines": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
        "thesis": { "type": "string", "minLength": 1, "maxLength": 220 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index", "company", "role", "decision", "proof", "href", "linkState"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "index": { "type": "string" },
          "company": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1, "maxLength": 130 },
          "proof": { "type": "string", "minLength": 1 },
          "href": { "type": ["string", "null"] },
          "linkState": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseFlow" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "caseFlow": {
      "type": "object",
      "required": ["caseId", "caseLabel", "introPrimary", "introEmphasis", "introBody", "diff", "artifact", "validation", "boundary", "transfer", "trace"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "caseLabel": { "type": "string" },
        "introPrimary": { "type": "string" },
        "introEmphasis": { "type": "string" },
        "introBody": { "type": "string" },
        "diff": { "$ref": "#/$defs/diff" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "validation": { "$ref": "#/$defs/validation" },
        "boundary": { "$ref": "#/$defs/boundary" },
        "transfer": { "$ref": "#/$defs/transfer" },
        "trace": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/traceStep" }
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["status", "evidenceIds", "publicSafe"],
      "properties": {
        "status": { "enum": ["verified", "supported", "internal", "unproven"] },
        "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "publicSafe": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["evidenceId", "staticId", "title", "meta", "quote", "note", "state", "proofStatus"],
      "properties": {
        "evidenceId": { "type": "string" },
        "staticId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "meta": { "type": "string" },
        "quote": { "type": "string", "maxLength": 320 },
        "note": { "type": "string" },
        "state": { "type": "string" },
        "proofStatus": { "type": "string" }
      },
      "additionalProperties": false
    },
    "traceStep": {
      "type": "object",
      "required": ["id", "number", "kind", "label", "date", "title", "body", "claim"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "number": { "type": "string" },
        "kind": { "enum": ["signal", "decision", "artifact", "proof", "unknown"] },
        "label": { "type": "string" },
        "date": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 96 },
        "body": { "type": "string", "minLength": 1, "maxLength": 320 },
        "claim": { "$ref": "#/$defs/claim" },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "type", "status", "visibility", "permission", "provenance", "placeholder"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "enum": ["call", "artifact", "quote", "commit", "metric", "document"] },
        "status": { "enum": ["verified", "supported", "internal", "unproven", "placeholder"] },
        "visibility": { "enum": ["public", "private", "restricted"] },
        "permission": { "enum": ["public", "approved", "reconstruction-only", "unknown"] },
        "provenance": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["inheritedLabel", "inheritedTitle", "inheritedBody", "reframedLabel", "reframedTitle", "reframedBody"],
      "properties": {
        "inheritedLabel": { "type": "string" },
        "inheritedTitle": { "type": "string" },
        "inheritedBody": { "type": "string" },
        "reframedLabel": { "type": "string" },
        "reframedTitle": { "type": "string" },
        "reframedBody": { "type": "string" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "required": ["variant", "evidenceId", "contextLabel", "type", "title", "amount", "surfaceLabel", "property", "description", "choices", "footer", "status", "caption", "provenance", "callouts"],
          "properties": {
            "variant": { "const": "repair-statement" },
            "evidenceId": { "type": "string" },
            "contextLabel": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" },
            "amount": { "type": "string" },
            "surfaceLabel": { "type": "string" },
            "property": { "type": "string" },
            "description": { "type": "string" },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["index", "label", "value", "active"],
                "properties": {
                  "index": { "type": "string" },
                  "label": { "type": "string" },
                  "value": { "type": "string" },
                  "active": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "footer": { "type": "string" },
            "status": { "type": "string" },
            "caption": { "type": "string" },
            "provenance": { "type": "string" },
            "callouts": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["variant", "evidenceId", "contextLabel", "type", "title", "summary", "stages", "output", "footer", "status", "caption", "provenance", "callouts"],
          "properties": {
            "variant": { "const": "workflow-system" },
            "evidenceId": { "type": "string" },
            "contextLabel": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "stages": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["index", "label", "detail", "state"],
                "properties": {
                  "index": { "type": "string" },
                  "label": { "type": "string" },
                  "detail": { "type": "string" },
                  "state": { "enum": ["complete", "active", "queued"] }
                },
                "additionalProperties": false
              }
            },
            "output": {
              "type": "object",
              "required": ["label", "title", "detail"],
              "properties": {
                "label": { "type": "string" },
                "title": { "type": "string" },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            },
            "footer": { "type": "string" },
            "status": { "type": "string" },
            "caption": { "type": "string" },
            "provenance": { "type": "string" },
            "callouts": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["variant", "evidenceId", "contextLabel", "type", "title", "image", "footer", "status", "caption", "provenance", "callouts"],
          "properties": {
            "variant": { "const": "source-image" },
            "evidenceId": { "type": "string" },
            "contextLabel": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" },
            "image": {
              "type": "object",
              "required": ["src", "alt", "width", "height"],
              "properties": {
                "src": { "type": "string", "pattern": "^/" },
                "alt": { "type": "string", "minLength": 1 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "footer": { "type": "string" },
            "status": { "type": "string" },
            "caption": { "type": "string" },
            "provenance": { "type": "string" },
            "callouts": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": ["evidenceId", "quote", "label", "status"],
      "properties": { "evidenceId": { "type": "string" }, "quote": { "type": "string" }, "label": { "type": "string" }, "status": { "type": "string" } },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["label", "title", "body"],
      "properties": { "label": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" } },
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "required": ["label", "primary", "emphasis", "note"],
      "properties": { "label": { "type": "string" }, "primary": { "type": "string" }, "emphasis": { "type": "string" }, "note": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
