{
  "version": "0.2.0",
  "color": {
    "paper": { "cssVariable": "--paper", "value": "#F3F0E8", "role": "page background" },
    "paperRaised": { "cssVariable": "--paper-raised", "value": "#FBF9F3", "role": "artifact and drawer surface" },
    "ink": { "cssVariable": "--ink", "value": "#161916", "role": "primary text and built artifacts" },
    "inkSoft": { "cssVariable": "--ink-soft", "value": "#656A63", "role": "secondary text" },
    "rule": { "cssVariable": "--rule", "value": "#C9C8BF", "role": "hairlines and inactive structure" },
    "ruleDark": { "cssVariable": "--rule-dark", "value": "#999B94", "role": "inactive trace nodes" },
    "signal": { "cssVariable": "--signal", "value": "#315CFF", "role": "observed evidence for large text, rules, and nodes" },
    "signalText": { "cssVariable": "--signal-text", "value": "#2346C7", "role": "contrast-safe observed-evidence labels" },
    "decision": { "cssVariable": "--decision", "value": "#F05235", "role": "Sergey's judgment for large text, rules, and nodes" },
    "decisionText": { "cssVariable": "--decision-text", "value": "#B53725", "role": "contrast-safe decision labels" },
    "proof": { "cssVariable": "--proof", "value": "#16745A", "role": "outside validation for large text, rules, and nodes" },
    "proofText": { "cssVariable": "--proof-text", "value": "#0F664E", "role": "contrast-safe proof labels" },
    "unknown": { "cssVariable": "--unknown", "value": "#8A8177", "role": "caveat or unresolved boundary rules and nodes" },
    "unknownText": { "cssVariable": "--unknown-text", "value": "#625B53", "role": "contrast-safe boundary labels" },
    "highlight": { "cssVariable": "--highlight", "value": "#DDF45B", "role": "rare annotation marker and selection" }
  },
  "type": {
    "display": { "family": "Newsreader Variable", "cssVariable": "--font-display", "nextFontExport": "Newsreader", "weights": [350, 380, 400, 410, 450], "use": "thought lines and external quotes" },
    "body": { "family": "IBM Plex Sans", "cssVariable": "--font-sans", "nextFontExport": "IBM_Plex_Sans", "weights": [400, 500, 600], "use": "narrative and controls" },
    "mono": { "family": "IBM Plex Mono", "cssVariable": "--font-mono", "nextFontExport": "IBM_Plex_Mono", "weights": [400, 500], "use": "dates, sources, state, and provenance" },
    "displaySize": { "cssVariable": "--type-display-size", "value": "clamp(4.1rem, 8.85vw, 9rem)" },
    "sectionTitleSize": { "cssVariable": "--type-section-title-size", "value": "clamp(3.15rem, 6.1vw, 6.6rem)" },
    "chapterTitleSize": { "cssVariable": "--type-chapter-title-size", "value": "clamp(2.8rem, 5.4vw, 5.8rem)" },
    "bodySize": { "cssVariable": "--type-body-size", "value": "1.0625rem" },
    "metaSize": { "cssVariable": "--type-meta-size", "value": "0.7rem" },
    "proseMax": { "cssVariable": "--measure-prose", "value": "66ch" },
    "decisionMax": { "cssVariable": "--measure-decision", "value": "22ch" }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px",
    "32": "128px"
  },
  "surface": {
    "radiusSmall": { "cssVariable": "--radius-sm", "value": "3px" },
    "artifactShadow": { "cssVariable": "--shadow-plate", "value": "0 1px 0 rgb(22 25 22 / 12%), 0 16px 40px rgb(22 25 22 / 6%)" }
  },
  "grid": {
    "desktop": { "columns": { "cssVariable": "--grid-columns", "value": 16 }, "gutter": { "cssVariable": "--grid-gutter", "value": "24px" }, "maxWidth": { "cssVariable": "--page-max", "value": "1400px" }, "pageEdge": { "cssVariable": "--page-edge", "value": "clamp(24px, 4vw, 72px)" } },
    "tablet": { "columns": { "cssVariable": "--grid-columns", "value": 8 }, "gutter": { "cssVariable": "--grid-gutter", "value": "20px" }, "pageEdge": { "cssVariable": "--page-edge", "value": "clamp(22px, 3vw, 40px)" }, "breakpoint": { "value": "1100px" } },
    "mobile": { "columns": { "cssVariable": "--grid-columns", "value": 4 }, "gutter": { "cssVariable": "--grid-gutter", "value": "12px" }, "pageEdge": { "cssVariable": "--page-edge", "value": "16px" }, "breakpoint": { "value": "760px" } }
  }
}
