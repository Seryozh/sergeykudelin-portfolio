{
  "version": "0.2.0",
  "purpose": "Expose causality, evidence disclosure, hierarchy, and navigation state.",
  "durationMs": {
    "instant": 100,
    "micro": 140,
    "backdrop": 160,
    "state": 180,
    "control": 200,
    "context": 240,
    "panelExit": 220,
    "panel": 320,
    "reveal": 420,
    "route": 440,
    "traceIntro": 520,
    "hero": 560
  },
  "easing": {
    "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
    "standard": "cubic-bezier(0.2, 0, 0, 1)",
    "route": "cubic-bezier(0.65, 0, 0.35, 1)",
    "exit": "cubic-bezier(0.7, 0, 0.84, 0)"
  },
  "limits": {
    "heroTravelDesktopPx": 20,
    "heroTravelMobilePx": 12,
    "sectionTravelDesktopPx": 16,
    "sectionTravelMobilePx": 10,
    "hoverLiftPx": 3,
    "maxScalePercent": 1.5,
    "maxStaggerItems": 4,
    "maxStaggerTotalMs": 240,
    "maxEntranceTotalMs": 950
  },
  "entrance": [
    { "id": "navigation", "delayCssVariable": "--entrance-navigation-delay", "atMs": 0, "target": "navigation", "effect": "opacity + translateY(-6px)", "durationToken": "control", "durationMs": 200 },
    { "id": "context", "delayCssVariable": "--entrance-context-delay", "atMs": 40, "target": "context", "effect": "opacity + translateY(8px)", "durationToken": "context", "durationMs": 240 },
    { "id": "eyebrow", "delayCssVariable": "--entrance-eyebrow-delay", "atMs": 40, "target": "eyebrow", "effect": "opacity + translateY(12px)", "durationToken": "reveal", "durationMs": 420 },
    { "id": "headline-1", "delayCssVariable": "--entrance-headline-1-delay", "atMs": 80, "target": "headline line 1", "effect": "clip reveal + translateY(20px)", "durationToken": "hero", "durationMs": 560 },
    { "id": "headline-2", "delayCssVariable": "--entrance-headline-2-delay", "atMs": 150, "target": "headline line 2", "effect": "clip reveal + translateY(20px)", "durationToken": "hero", "durationMs": 560 },
    { "id": "thesis", "delayCssVariable": "--entrance-thesis-delay", "atMs": 240, "target": "thesis", "effect": "opacity + translateY(12px)", "durationToken": "reveal", "durationMs": 420 },
    { "id": "note", "delayCssVariable": "--entrance-note-delay", "atMs": 340, "target": "note", "effect": "opacity + translateY(12px)", "durationToken": "reveal", "durationMs": 420 },
    { "id": "trace", "delayCssVariable": "--entrance-trace-delay", "atMs": 420, "target": "first trace segment", "effect": "direct line draw", "durationToken": "traceIntro", "durationMs": 520 }
  ],
  "chapterStates": ["unseen", "entered", "active", "complete"],
  "chapterRules": {
    "enterAtViewportPercent": 78,
    "activeAtViewportPercent": 48,
    "narrativeDelayMs": 60,
    "artifactDelayMs": 120,
    "replayAfterEntry": false
  },
  "trace": {
    "baseWidthPx": 1,
    "progressWidthPx": 2,
    "dormantNodePx": 4,
    "activeNodePx": 8,
    "completeNodePx": 6,
    "segmentStartViewportPercent": 72,
    "segmentEndViewportPercent": 44,
    "scrollLinked": true,
    "delayedCatchup": false
  },
  "reducedMotion": {
    "transforms": false,
    "clipReveals": false,
    "traceDrawing": false,
    "smoothScroll": false,
    "contentVisibleImmediately": true
  },
  "forbidden": [
    "continuous animation",
    "parallax",
    "scroll hijacking",
    "custom cursor",
    "traveling trace dot",
    "glow trail",
    "autoplay media",
    "letter-by-letter text reveal",
    "transition: all"
  ]
}
