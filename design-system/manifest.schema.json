{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Trace design-system manifest",
  "type": "object",
  "required": ["$schema", "name", "version", "status", "canonicalSpecimen", "description", "readOrder", "authority", "allowedTraceStates", "requiredChecks"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "const": "Decision Trace" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "locked", "deprecated"] },
    "canonicalSpecimen": { "type": "string" },
    "description": { "type": "string" },
    "readOrder": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authority": {
      "type": "object",
      "required": ["designIntent", "implementationRules", "visualReference", "styles"],
      "properties": {
        "designIntent": { "type": "string" },
        "implementationRules": { "type": "string" },
        "visualReference": { "type": "string" },
        "styles": { "type": "string" }
      },
      "additionalProperties": false
    },
    "allowedTraceStates": {
      "type": "array",
      "items": { "enum": ["signal", "decision", "artifact", "proof", "unknown"] },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "requiredChecks": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
