{
  "$schema": "./manifest.schema.json",
  "name": "Decision Trace",
  "version": "0.2.0",
  "status": "locked",
  "canonicalSpecimen": "/",
  "description": "A warm editorial portfolio system that makes product judgment visible as a trace from signal through decision, artifact, proof, and boundary.",
  "readOrder": [
    "../AGENTS.md",
    "../DESIGN_SYSTEM.md",
    "tokens.json",
    "motion.json",
    "components.json",
    "acceptance.json",
    "../content/site.schema.json",
    "../content/site.json"
  ],
  "authority": {
    "designIntent": "../DESIGN_SYSTEM.md",
    "implementationRules": "../AGENTS.md",
    "visualReference": "../app/components/DecisionTracePortfolio.tsx",
    "styles": "../app/globals.css"
  },
  "allowedTraceStates": [
    "signal",
    "decision",
    "artifact",
    "proof",
    "unknown"
  ],
  "requiredChecks": [
    "npm run validate:design",
    "npm run typecheck",
    "npm run lint",
    "npm run build",
    "npm test"
  ]
}
